programa
{
	
	funcao inicio()
	{
		caracter vogal, consoante

		vogal = 'a' //variável declarada pelo programador


		escreva("Digite uma consoante: ")
		leia(consoante) //variável declarada pelo usuário

		escreva("Vogal: ", vogal, "\n", "Consoante: ", consoante)

		
	}
}
