programa
{
	
	funcao inicio()
	{
		//Comparação entre A e B utilizando o operador maior que
		inteiro a = 5, b = 3

		se(a > b){
			escreva("A é maior que B")
		}

		//Comparação entre A e B utilizando o operador igual a
		se(a == b){
			escreva("A é igual a B")	
		}

		//Comparação entre A e B utllizando o operador maior ou igual a
		se(a >= b){
			escreva("A é maior ou igual a B")	
		}

		
	}
}
