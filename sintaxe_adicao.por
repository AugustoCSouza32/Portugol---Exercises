programa
{
	
	funcao inicio()
	{
		escreva(1+5,"\n") //Operação Aritmética 1 + 5 sendo escrita na tela

		real numero =  50 + 30 //Operação Aritmética 50+30 sendo armazenada na variável

		se (20 + 40 < 50){
			//Operação Aritmética 20+40 dentro de uma estrutura de controle "se" em conjunto com uma operação relacional.
		}

		/*
		 * Também podemos usar a adição em cadeia de caracter ou em caracteres, exemplo:
		 * 
		 * "Oi" + "Mundo" = "Oi mundo"
		 * "Banan" + 'a' = "Banana"
		 * "Faz um" + 21 = "Faz um 21"
		 * "Altura: " + 1.78 = "Altura: 1.78"
		 * "Help bom=" + verdadeiro = "Help bom = verdadeiro"
		 * 'P' + anqueca = "Panqueca"
		 * 'C'+'a'+'d'+'e'+'i'+'a' = "Cadeia"
		 * 22 + "de agosto" = "22 de agosto"
		 * 12 + 34 = 46
		 * 76 + 3.25 = 79.25
		 * 3.24 + "Kg" = "3.24 Kg"
		 * 9.87 + 1 = 10.87
		 * 9.87 + 0.13 = 10.0
		 * verdadeiro + "amigo" = "verdadeiro amigo"
		 */

		 inteiro valor
		 escreva(5+8, "\n")

		 valor = 5+8
		 escreva(valor)
	}

	
}
