programa
{
	
	funcao inicio()
	{
		/*
		 * 
		 * Divisão é a operação inversa da multiplicação. É utilizada para, como o próprio nome sugere, dividir
		 * ,repartir,separar algum valor em partes iguais. Seus elementos são:
		 * dividendo (o que se quer dividir)
		 * divisor (em quantas partes quer dividir)
		 * quociente (resultado da divisão)
		 * resto (O que sobra)
		 */

		 escreva(15 / 5)
		 pula_linha()

		 real numero = 50/25.6

		 //Reintegradora: Multiplicando o quociente pelo divisor se obtém o dividendo.
		 //Associatividade: Quando o divisor for 1, o dividendo e o quociente são iguais.

		 inteiro valor

		 escreva(20/10)
		 pula_linha()

		 valor = 20/10

		 escreva(valor)
		 
	}
	funcao vazio pula_linha(){
		escreva("\n")	
	}
}
