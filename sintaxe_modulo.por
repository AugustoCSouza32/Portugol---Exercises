programa
{
	
	funcao inicio()
	{
		/*
		 * A operação módulo encontra o resto da divisão de um número por outro. Dados dois números a(o dividendo)
		 * e b(o divisor), a modulo b (a%b) é o resto da divisão de a por b. Por exemplo, 7 % 3 seria 1, enquanto
		 * 9 % 3 seria 0.
		 */

		 escreva(13 % 5)
		 pula_linha()

		 real numero = 50 % 4
		 escreva(numero)
		 pula_linha()

		 inteiro valor
		 escreva(7 % 3)
		 pula_linha()

		 valor = 7%3
		 escreva(valor)
		 
	}

	funcao vazio pula_linha(){
		escreva("\n")	
	}
}
