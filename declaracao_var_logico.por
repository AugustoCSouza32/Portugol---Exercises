programa
{
	
	funcao inicio()
	{
		logico teste
		inteiro num
		
		escreva("Digite um valor para ser comparado: ")
		leia(num)

		teste = (num > 0)

		escreva("O número digitado é maior do que zero? ", teste)

		
	}
}
