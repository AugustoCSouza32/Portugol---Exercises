programa
{
	
	funcao inicio()
	{
		escreva(1*5)//Operação Aritmética 1*5 sendo escrita na tela.
		pula_linha()
		real numero = 50 * 30//Operação sendo armazenada em uma variável

		escreva(5*(5+5))//Distributividade: Um fator colocado em evidêncianuma soma dará como produto a soma
					//do produto daquele fator com os demais fatores. Assim x*(y+z) = (x*y)+(x*y)
		pula_linha()

		
		inteiro valor
		escreva(3*4)
		pula_linha()
		valor = 3*4
		escreva(valor)
	}

	funcao vazio pula_linha(){
		escreva("\n")	
	}
}
