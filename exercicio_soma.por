programa
{
	/*
	Fazer um programa para ler dois inteiro X e Y, e depois mostrar na tela
	o valor da soma destes números.
	*/
	funcao inicio()
	{
		inteiro x, y, soma
		
		escreva("Digite o valor de X: \n")
		leia(x)
		
		escreva("Digite o valor de Y: \n")
		leia(y)
		
		soma = x + y

		escreva("SOMA: ", soma)
	}
}
