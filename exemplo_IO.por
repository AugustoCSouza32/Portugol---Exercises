programa
{
	
	funcao inicio()
	{
		inteiro idade
		real salario, nota1, nota2, nota3
		cadeia nome, sobrenome


		leia(idade, salario,nome,sobrenome,nota1,nota2,nota3)
		limpa()

		escreva("Nome: ",nome,"\n"
			  ,"Sobrenome: ",sobrenome,"\n"
			  ,"Idade: ",idade,"\n"
			  ,"Salario: ",salario,"\n"
			  ,"Notas: ",nota1,",",nota2,",",nota3)
		
	}
}
