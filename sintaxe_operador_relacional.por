programa
{
	
	funcao inicio()
	{
		/*
		 * Operações Relacionais:
		 * Em algoritmos,os operados relacionais são importantes porque permitem realizar comparações que terão como
		 * resultado um valor lógico (verdadeiro ou falso).
		 * 
		 * Os simbolos para diferente, maior ou igual, menor ou igual mudam em relação aos que usamos na matemática
		 * pois não existem nos teclados convencionais.
		 * Maior >
		 * Menor <
		 * Maior ou igual >=
		 * Menor ou igual <=
		 * Igual ==
		 * Diferente !=
		 * 
		 * estrutura de algumas das operações:
		 * 3 > 4 -------->falso
		 * 7 != 7 ------->falso
		 * 9 == 10-1 ---->Verdadeiro
		 * 33 <= 100 ---->Verdadeiro
		 * 6 >= 5+1 ----->verdadeiro
		 * 5+4 <= 11-2 -->Verdadeiro
		 * 
		 * Quando temos operadores aritméticos e relacionais juntos, realiza-se primeiro a operação aritmética e depois a relacional.
		 * 
		 * Em geral, as operações relacionais são utilizadas em conjunto com as estruturas de controle. Veja sintaxe:
		 */

		 se (5 > 3){ //Estrutura de controle: "se (...), operação relacional: "5 > 3"
		 	//Conjunto de comandos se for verdadeiro	
		 }


		 inteiro i
		 para (i = 0; i < 5; i++){//Estrutura de controle: "para(...), Operação relacional: "i < 5"
		 
		 	//conjunto de comandos a serem repetido até a Expressão se tornar falsa.
		 
		 }

		 faca{//Estrtutura de controle: "faca{}enquanto(...), Operação reçacional: "6 < 2"

		 	//conjunto de comandos a serem repetidos enquanto a condicão for verdadeira após a primeira execução.
		 
		 }enquanto (6 < 2)
	}
}
